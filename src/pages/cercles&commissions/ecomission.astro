---
import Layout from "@layouts/Layout.astro";
import Links, { LinkType } from "@components/Links.astro";

import _CommHisto from "@images/commissions/ecomission.jpg";
import _NettoyageJardins from "@images/commissions/ecomission-nettoyage-jardins.jpg";
import _AfficheNettoyage from "@images/commissions/ecomission-affiche-nettoyage.jpg";

import { Image } from "astro:assets";

const commission = "Écomission";

const comite = [
  { role: "", name: "Margaux Wolf Bayot" },
  { role: "", name: "Charline Bellet" },
  { role: "", name: "Guillaume Chamart" },
  { role: "", name: "Marion André" },
  { role: "", name: "Eva Kabelis" },
  { role: "", name: "Alexis Michel" },
];
const links: { name: string; type: LinkType; url: string }[] | undefined = [
  {
    name: "Instagram",
    type: LinkType.INSTAGRAM,
    url: "https://www.instagram.com/ecomission185/",
  },
];
---

<Layout title={commission}>
  <main class="container mt-4 space-y-6" transition:animate="slide">
    <div class="h-64 w-full overflow-hidden rounded-2xl">
      <Image
        class="-z-10 h-full w-full object-cover"
        src={_CommHisto}
        alt={commission}
        quality={100}
        format="webp"
      />
    </div>
    <div class="mx-auto max-w-5xl space-y-6">
      <h1 class="text-5xl font-semibold">{commission}</h1>
      <section class="space-y-4 text-justify">
        <h2 class="text-3xl font-medium text-emerald-800">
          🌱 Construisons l'écologie ensemble !
        </h2>
        <p>
          C’est dans cet esprit qu’est née l’Écomission de la Faculté Polytechnique
          de Mons : un groupe d’étudiants qui mettent en place des idées, des initiatives
          et des activités concrètes pour les étudiants.
        </p>
        <p>
          Chaque année, de nouvelles idées peuvent voir le jour grâce à celles et
          ceux qui souhaitent rejoindre l’aventure. 💚
        </p>
        <p>
          Notre terrain de départ, c’est la Cité Houzeau, historiquement liée aux
          étudiants de la Polytech. Cependant, certains projets peuvent s’étendre
          aux autres résidences de l’UMONS et toucher tous les étudiants qui étudient
          sur nos campus.
        </p>

        <figure class="pt-2">
          <div class="flex justify-center overflow-hidden rounded-xl bg-emerald-50 p-2">
            <Image
              class="h-auto max-h-96 w-auto max-w-full rounded-lg object-contain"
              src={_NettoyageJardins}
              alt="Étudiants réunis après un nettoyage des jardins de la Cité Houzeau"
              quality={80}
              format="webp"
            />
          </div>
          <figcaption class="mt-2 text-center text-sm italic text-emerald-800">
            Nettoyage des jardins de la Cité Houzeau
          </figcaption>
        </figure>
      </section>

      <section class="grid gap-6 lg:grid-cols-2 lg:items-center">
        <div class="space-y-4">
          <h2 class="text-2xl font-medium text-emerald-800">
            ♻️ Concrètement, on fait quoi ?
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
            <li class="rounded-lg border-l-4 border-emerald-700 bg-emerald-50 p-3">
              Nettoyages des jardins de la Cité Houzeau
            </li>
            <li class="rounded-lg border-l-4 border-emerald-700 bg-emerald-50 p-3">
              Sensibilisation à une consommation plus durable
            </li>
            <li class="rounded-lg border-l-4 border-emerald-700 bg-emerald-50 p-3">
              Création de solutions de tri adaptées à la vie en kot
            </li>
            <li class="rounded-lg border-l-4 border-emerald-700 bg-emerald-50 p-3">
              Vide-dressings
            </li>
          </ul>
        </div>

        <Image
          class="h-auto w-full rounded-xl shadow-md"
          src={_AfficheNettoyage}
          alt="Affiche du concours de nettoyage du jardin de la Cité"
          quality={80}
          format="webp"
        />
      </section>

      <section
        class="space-y-3 rounded-xl border-l-4 border-emerald-700 bg-emerald-50 p-5 text-center"
      >
        <p>
          Alors si tu es intéressé, tu peux suivre nos différents événements sur
          Facebook ou sur l'Instagram Fédé.
        </p>
        <p class="italic">
          En espérant vous revoir bientôt,<br />
          L’Écomission 🍀🌿
        </p>
      </section>
      <section
        class="mx-auto max-w-sm rounded-lg border-r-4 border-blue-900 bg-white px-8 py-4 font-medium shadow-box"
      >
        <h2 class="pb-4 text-center text-xl">Comité</h2>
        <ul>
          {
            comite.map(({ role, name }) => (
              <li>
                {role ? <strong>{role} : </strong> : ""}
                {name}
              </li>
            ))
          }
        </ul>
      </section>
      {links && links[0] ? <Links links={links} /> : ""}
    </div>
  </main>
</Layout>
